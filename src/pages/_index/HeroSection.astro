---
import Hero from '@components/ui/Hero.astro'
import Stars from '@components/ui/Stars.astro';
---

<section>
  <div>
    <Hero />
  </div>
  <Stars />
</section>

<style>
  section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    color: var(--white);
    border-radius: 1rem;

    & div {
      position: absolute;
      text-align: center;

      & img {
        width: 100%;
        max-width: 315px;
      }
    }
  }
</style>
